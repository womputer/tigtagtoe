# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key for the agent. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model the agent uses.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Where SQLite lives on disk. Defaults to ./tigtagtoe.db
DATABASE_URL=sqlite:///./tigtagtoe.db

# Comma-separated origins the API will accept.
# Production Vercel + local Vite are included by default.
CORS_ORIGINS=http://localhost:5173,https://tigtagtoe.vercel.app

# Max emails the agent will process in a single run. Safety cap.
MAX_EMAILS_PER_RUN=300

# How many emails to send to the model concurrently. Tune for rate limits.
AGENT_CONCURRENCY=5

# Cap the body length sent to the model (in characters).
MAX_BODY_CHARS=4000

# Frontend (Vite, build-time). Point at local API in dev; on Vercel set this
# to your Render service URL, e.g. https://tigtagtoe-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
